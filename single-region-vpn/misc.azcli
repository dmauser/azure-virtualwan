# Miscellaneous troubleshooting commands for the single-region-vpn lab
# Run bgpinfo.azcli for formatted BGP peer status tables.

# Parameters
rg=lab-vwan-vpn
hubname=vhub1
subid=$(az account show --query id -o tsv)
vhubgwname=$(az network vpn-gateway list --resource-group $rg --query "[?contains(name, '$hubname')].name" -o tsv)
branchgw=branch-vpngw
bgppeer=$(az network vnet-gateway show -n $branchgw -g $rg --query 'bgpSettings.bgpPeeringAddresses[0].defaultBgpIpAddresses[0]' -o tsv)

# vHub VPN Gateway BGP settings and connections
az network vpn-gateway show -g $rg -n $vhubgwname --query bgpSettings
az network vpn-gateway connection list -g $rg --gateway-name $vhubgwname --query '[].{name:name,enableBgp:enableBgp,protocol:vpnConnectionProtocolType,state:provisioningState}' -o table

# vHub effective routes (defaultRouteTable)
az network vhub get-effective-routes -g $rg -n $hubname \
 --resource-type RouteTable \
 --resource-id $(az network vhub route-table show --name defaultRouteTable --vhub-name $hubname -g $rg --query id -o tsv) \
 --query 'value[].{prefix:addressPrefixes[0],asPath:asPath,nextHopType:nextHopType}' -o table

# Spoke VM effective routes
az network nic show-effective-route-table -g $rg -n spoke1VMVMNic -o table

# Routing intent (only present if routing intent is configured on the hub)
az rest --method get --uri "/subscriptions/$subid/resourceGroups/$rg/providers/Microsoft.Network/virtualHubs/$hubname/routingIntent?api-version=2022-01-01"

# Branch VNG: connection status, learned and advertised routes
for conn in $(az network vpn-connection list -g $rg --query '[].name' -o tsv); do
    echo "$conn: $(az network vpn-connection show -g $rg -n $conn --query connectionStatus -o tsv)"
done
az network vnet-gateway list-learned-routes -g $rg -n $branchgw -o table
az network vnet-gateway list-advertised-routes -g $rg -n $branchgw --peer $(az network vpn-gateway show -g $rg -n $vhubgwname --query 'bgpSettings.bgpPeeringAddresses[0].defaultBgpIpAddresses[0]' -o tsv) -o table

# vHub VPN Gateway BGP peer status for the branch peer (long-running POST - see bgpinfo.azcli for polling the result)
az rest --method post \
 --url "https://management.azure.com/subscriptions/$subid/resourceGroups/$rg/providers/Microsoft.Network/vpnGateways/$vhubgwname/getbgppeerstatus?api-version=2023-06-01&peer=$bgppeer"
